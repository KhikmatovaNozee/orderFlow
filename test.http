### Login seller
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "login": "seller1",
  "password": "password123"
}

> {%
    client.global.set("seller_access_token", response.body.access_token);
    client.log(response.body.access_token);
%}

